---
import { getDiaries } from '../lib/data';
import Layout from '../layouts/Layout.astro';

let diaries: any[] = [];
try {
  const data = await getDiaries(1, 30);
  diaries = data.list || [];
} catch (e) {
  console.error('获取日记失败:', e);
}
---

<Layout title="日记">
  <div class="max-w-2xl">
    <h1 class="text-2xl sm:text-3xl font-bold mb-2 gradient-text" style="font-family:var(--font-heading)">📔 日记</h1>
    <p class="text-[var(--color-text-secondary)] mb-8">随时随地，记录生活 · {diaries.length} 条记录</p>
    {diaries.length > 0 ? (
      <div class="space-y-6 relative before:absolute before:left-[15px] before:top-4 before:bottom-4 before:w-0.5 before:bg-[var(--color-border)]">
        {diaries.map((e: any) => (
          <div class="flex gap-4 pl-10 relative">
            <span class="absolute left-0 top-1.5 w-7 h-7 rounded-full bg-[var(--color-primary-light)] flex items-center justify-center text-sm z-10 border-2 border-[var(--color-bg)]">{e.weather || '📔'}</span>
            <div class="glass rounded-xl p-4 flex-1 card-accent" style="box-shadow:var(--shadow-card)">
              <p class="text-sm text-[var(--color-text)] leading-relaxed">{e.content}</p>
              <div class="flex items-center gap-3 mt-2 text-xs text-[var(--color-text-secondary)]">
                <time>{new Date(e.createdAt).toLocaleDateString('zh-CN')}</time>
                {e.location && <span>📍 {e.location}</span>}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-[var(--color-text-secondary)]"><div class="text-5xl mb-4">📔</div><p>还没有日记</p></div>
    )}
  </div>
</Layout>
