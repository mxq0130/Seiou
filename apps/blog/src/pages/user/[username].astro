---
import Layout from '../../layouts/Layout.astro';
import AnimeCard from '../../components/AnimeCard.astro';

const { username } = Astro.params;
let profile: any = null;
let error = '';

try {
  const res = await fetch(`http://127.0.0.1:3000/api/v1/users/profile/${username}`);
  const json: any = await res.json();
  if (json.code === 0) profile = json.data;
  else error = json.message || '加载失败';
} catch { error = '加载失败'; }
---

<Layout title={`${username} 的主页`}>
  {error ? (
    <div class="text-center py-16"><div class="text-5xl mb-4">😢</div><p class="text-[var(--color-text-secondary)]">{error}</p></div>
  ) : profile ? (
    <div class="max-w-4xl">
      <!-- 用户信息 -->
      <section class="glass rounded-xl p-6 mb-6">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] flex items-center justify-center text-white text-4xl shrink-0" style="font-family:var(--font-title)">
            {profile.user.username[0]}
          </div>
          <div>
            <h1 class="text-2xl font-bold mb-1" style="font-family:var(--font-heading)">{profile.user.username}</h1>
            <span class={`text-xs px-2 py-0.5 rounded-full ${profile.user.role==='ADMIN'?'bg-red-100 text-red-600':'bg-blue-100 text-blue-600'}`}>{profile.user.role === 'ADMIN' ? '管理员' : '博主'}</span>
            <p class="text-xs text-[var(--color-text-secondary)] mt-2">加入于 {new Date(profile.user.createdAt).toLocaleDateString('zh-CN')}</p>
          </div>
        </div>
      </section>

      <!-- 发布的文章 -->
      <section class="mb-6">
        <h2 class="text-lg font-bold mb-4" style="font-family:var(--font-heading)">📝 发布的文章 ({profile.posts.length})</h2>
        {profile.posts.length > 0 ? (
          <div class="space-y-3">
            {profile.posts.map((p: any) => (
              <a href={`/posts/${p.slug}`} class="glass rounded-xl p-4 block hover:-translate-y-1 transition-all flex gap-4 items-center">
                {p.cover && <img src={p.cover} class="w-20 h-14 rounded-lg object-cover shrink-0" />}
                <div class="min-w-0">
                  <h3 class="font-medium text-[var(--color-text)] truncate">{p.title}</h3>
                  <p class="text-xs text-[var(--color-text-secondary)]">{new Date(p.createdAt).toLocaleDateString('zh-CN')}</p>
                </div>
              </a>
            ))}
          </div>
        ) : <p class="text-sm text-[var(--color-text-secondary)] text-center py-8">还没有发布过文章</p>}
      </section>

      <!-- 追番 -->
      {profile.anime?.length > 0 && (
        <section>
          <h2 class="text-lg font-bold mb-4" style="font-family:var(--font-heading)">🎬 追番列表</h2>
          <div class="space-y-3">
            {profile.anime.map((a: any) => <AnimeCard {...a} />)}
          </div>
        </section>
      )}
    </div>
  ) : (
    <div class="text-center py-16"><div class="text-5xl mb-4">🔍</div><p class="text-[var(--color-text-secondary)]">加载中...</p></div>
  )}
</Layout>
