---
import Layout from '../layouts/Layout.astro';
---

<Layout title="注册">
  <div class="max-w-md mx-auto pt-8">
    <h1 class="text-2xl font-bold mb-8 text-center gradient-text" style="font-family:var(--font-heading)">✨ 注册新账号</h1>
    <div class="glass rounded-xl p-6" id="register-form">
      <div class="space-y-4">
        <div>
          <label class="text-sm text-[var(--color-text-secondary)] mb-1 block">用户名</label>
          <input id="reg-username" class="w-full p-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm" placeholder="给自己起个名字" />
        </div>
        <div>
          <label class="text-sm text-[var(--color-text-secondary)] mb-1 block">邮箱</label>
          <input id="reg-email" type="email" class="w-full p-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm" placeholder="email@example.com" />
        </div>
        <div>
          <label class="text-sm text-[var(--color-text-secondary)] mb-1 block">密码</label>
          <input id="reg-password" type="password" class="w-full p-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm" placeholder="至少6位密码" />
        </div>
        <button id="reg-btn" class="w-full py-3 rounded-full text-white font-medium" style="background:var(--color-gradient)">注 册</button>
      </div>
      <p id="reg-msg" class="text-xs text-center mt-3 hidden"></p>
      <p class="text-center text-sm text-[var(--color-text-secondary)] mt-4">
        已有账号？<a href="/login" class="text-[var(--color-primary)] hover:underline">立即登录</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  document.getElementById('reg-btn')?.addEventListener('click', async () => {
    const username = (document.getElementById('reg-username') as any)?.value;
    const email = (document.getElementById('reg-email') as any)?.value;
    const password = (document.getElementById('reg-password') as any)?.value;
    const msg = document.getElementById('reg-msg')!;
    if (!username || !email || !password) { msg.className='text-xs text-center mt-3 text-red-500'; msg.style.display='block'; msg.textContent='请填写所有字段'; return; }
    if (password.length < 6) { msg.className='text-xs text-center mt-3 text-red-500'; msg.style.display='block'; msg.textContent='密码至少6位'; return; }
    const btn = document.getElementById('reg-btn')!;
    btn.setAttribute('disabled','true'); btn.textContent = '注册中...';
    try {
      const res = await fetch('/api/v1/auth/register', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({username, email, password})
      });
      const json = await res.json();
      if (json.code === 0) {
        msg.className='text-xs text-center mt-3 text-green-500'; msg.style.display='block'; msg.textContent = '注册成功！即将跳转登录...';
        setTimeout(() => window.location.href = '/login', 1500);
      } else {
        msg.className='text-xs text-center mt-3 text-red-500'; msg.style.display='block'; msg.textContent = json.message || '注册失败';
      }
    } catch(e) {
      msg.className='text-xs text-center mt-3 text-red-500'; msg.style.display='block'; msg.textContent = '网络错误';
    }
    btn.removeAttribute('disabled'); btn.textContent = '注 册';
  });
</script>
