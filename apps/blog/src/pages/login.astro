---
import Layout from '../layouts/Layout.astro';
---

<Layout title="登录" description="登录到二次元博客">
  <div class="container-page py-12 sm:py-20">
    <div class="max-w-md mx-auto">
      <div class="card p-8">
        <div class="text-center mb-8">
          <span class="text-5xl mb-4 block">🌸</span>
          <h1 class="text-2xl font-bold" style="color: var(--color-text);">欢迎回来</h1>
          <p class="text-sm mt-2" style="color: var(--color-text-secondary);">登录你的账号</p>
        </div>

        <form class="flex flex-col gap-4">
          <div>
            <label for="email" class="block text-sm font-medium mb-1" style="color: var(--color-text);">邮箱</label>
            <input
              type="email" id="email" name="email" placeholder="your@email.com"
              class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none transition-colors"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);"
              class:list={["focus:border-[var(--color-primary)]"]}
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium mb-1" style="color: var(--color-text);">密码</label>
            <input
              type="password" id="password" name="password" placeholder="输入密码"
              class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none transition-colors"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);"
            />
          </div>

          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 cursor-pointer" style="color: var(--color-text-secondary);">
              <input type="checkbox" class="rounded" />
              记住我
            </label>
            <a href="#" class="hover:underline" style="color: var(--color-primary);">忘记密码？</a>
          </div>

          <button type="submit" class="w-full py-2.5 rounded-lg font-medium text-sm transition-all cursor-pointer mt-2"
            style="background: var(--color-primary); color: var(--color-on-primary); border: none;">
            登录
          </button>
        </form>

        <div class="mt-6 text-center text-sm" style="color: var(--color-text-secondary);">
          还没有账号？
          <a href="/register" class="font-medium ml-1 hover:underline" style="color: var(--color-primary);">立即注册</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
