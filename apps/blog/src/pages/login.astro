---
import Layout from '../layouts/Layout.astro';
const redirect = Astro.url.searchParams.get('redirect') || '/';
---

<Layout title="登录">
  <div class="max-w-md mx-auto pt-8">
    <h1 class="text-2xl font-bold mb-8 text-center gradient-text" style="font-family:var(--font-heading)">🔑 登录</h1>
    <div class="glass rounded-xl p-6" id="login-form">
      <div class="space-y-4">
        <div>
          <label class="text-sm text-[var(--color-text-secondary)] mb-1 block">用户名或邮箱</label>
          <input id="login-username" class="w-full p-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm" placeholder="admin 或 email@example.com" />
        </div>
        <div>
          <label class="text-sm text-[var(--color-text-secondary)] mb-1 block">密码</label>
          <input id="login-password" type="password" class="w-full p-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm" placeholder="••••••" />
        </div>
        <button id="login-btn" class="w-full py-3 rounded-full text-white font-medium" style="background:var(--color-gradient)">登 录</button>
      </div>
      <p id="login-msg" class="text-xs text-center mt-3 hidden"></p>
      <p class="text-center text-sm text-[var(--color-text-secondary)] mt-4">
        还没有账号？<a href="/register" class="text-[var(--color-primary)] hover:underline">立即注册</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  document.getElementById('login-btn')?.addEventListener('click', async () => {
    const username = (document.getElementById('login-username') as any)?.value;
    const password = (document.getElementById('login-password') as any)?.value;
    const msg = document.getElementById('login-msg')!;
    if (!username || !password) { msg.className='text-xs text-center mt-3 text-red-500'; msg.style.display='block'; msg.textContent='请填写用户名和密码'; return; }
    const btn = document.getElementById('login-btn')!;
    btn.setAttribute('disabled','true'); btn.textContent = '登录中...';
    try {
      const res = await fetch('/api/v1/auth/login', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({username, password})
      });
      const json = await res.json();
      if (json.code === 0) {
        localStorage.setItem('token', json.data.token);
        localStorage.setItem('user', JSON.stringify(json.data.user));
        const rd = '{redirect}';
        window.location.href = rd.replace(/&amp;/g,'&');
      } else {
        msg.className='text-xs text-center mt-3 text-red-500'; msg.style.display='block'; msg.textContent = json.message || '登录失败';
      }
    } catch(e) {
      msg.className='text-xs text-center mt-3 text-red-500'; msg.style.display='block'; msg.textContent = '网络错误';
    }
    btn.removeAttribute('disabled'); btn.textContent = '登 录';
  });
</script>
