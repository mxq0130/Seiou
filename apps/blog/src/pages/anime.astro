---
import Layout from '../layouts/Layout.astro';
import AnimeCard from '../components/AnimeCard.astro';

interface AnimeItem {
  title: string;
  cover: string;
  progress: number;
  total: number;
  rating: number;
  status: 'watching' | 'completed' | 'planning' | 'dropped';
  note?: string;
}

const animeList: AnimeItem[] = [
  { title: '某科学的超电磁炮 第四季', cover: '⚡', progress: 8, total: 24, rating: 5, status: 'watching', note: '炮姐赛高！' },
  { title: '孤独摇滚 第二季', cover: '🎸', progress: 6, total: 12, rating: 5, status: 'watching', note: '波奇酱~' },
  { title: '葬送的芙莉莲', cover: '⚔️', progress: 22, total: 28, rating: 5, status: 'watching' },
  { title: '怪兽8号', cover: '👹', progress: 3, total: 12, rating: 4, status: 'watching' },
  { title: '魔法少女', cover: '✨', progress: 1, total: 12, rating: 4, status: 'watching' },
  { title: '86-不存在的战区', cover: '🤖', progress: 23, total: 23, rating: 5, status: 'completed', note: '神作！' },
  { title: '魔法少女小圆', cover: '💎', progress: 12, total: 12, rating: 5, status: 'completed', note: '永远的经典' },
  { title: '夏日重现', cover: '🏝️', progress: 25, total: 25, rating: 5, status: 'completed' },
  { title: '约定的梦幻岛 第二季', cover: '🏰', progress: 4, total: 11, rating: 2, status: 'dropped', note: '...' },
  { title: '进击的巨人 最终季', cover: '🧱', progress: 0, total: 16, rating: 0, status: 'planning' },
];

const filtered = {
  watching: animeList.filter((a) => a.status === 'watching'),
  completed: animeList.filter((a) => a.status === 'completed'),
  planning: animeList.filter((a) => a.status === 'planning'),
  dropped: animeList.filter((a) => a.status === 'dropped'),
};
---

<Layout title="追番" description="我的追番列表">
  <div class="container-page py-8 sm:py-12">
    <div class="flex items-center justify-between mb-2">
      <h1 class="text-3xl font-bold" style="color: var(--color-text);">🎬 追番列表</h1>
      <span class="text-sm px-3 py-1 rounded-full" style="background: var(--color-primary-container); color: var(--color-on-primary-container);">
        共 {animeList.length} 部
      </span>
    </div>
    <p class="mb-8" style="color: var(--color-text-secondary);">
      追番数据自动同步自 B 站
    </p>

    <section class="mb-10">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--color-text);">
        <span class="w-3 h-3 rounded-full inline-block" style="background: var(--color-sky);"></span>
        追番中 ({filtered.watching.length})
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {filtered.watching.map((anime) => (
          <AnimeCard anime={anime} />
        ))}
      </div>
    </section>

    {filtered.completed.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--color-text);">
          <span class="w-3 h-3 rounded-full inline-block" style="background: var(--color-mint);"></span>
          已看完 ({filtered.completed.length})
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {filtered.completed.map((anime) => (
            <AnimeCard anime={anime} />
          ))}
        </div>
      </section>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {filtered.planning.length > 0 && (
        <div>
          <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--color-text);">
            <span class="w-3 h-3 rounded-full inline-block" style="background: var(--color-warm);"></span>
            想看 ({filtered.planning.length})
          </h2>
          <div class="space-y-3">
            {filtered.planning.map((anime) => (
              <AnimeCard anime={anime} compact />
            ))}
          </div>
        </div>
      )}
      {filtered.dropped.length > 0 && (
        <div>
          <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--color-text);">
            <span class="w-3 h-3 rounded-full inline-block" style="background: var(--color-text-secondary);"></span>
            已弃番 ({filtered.dropped.length})
          </h2>
          <div class="space-y-3">
            {filtered.dropped.map((anime) => (
              <AnimeCard anime={anime} compact />
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
