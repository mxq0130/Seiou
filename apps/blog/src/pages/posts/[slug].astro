---
import { getPostBySlug } from '../../lib/data';
import Layout from '../../layouts/Layout.astro';
import CommentSection from '../../components/CommentSection.astro';
import { marked } from 'marked';

const { slug } = Astro.params;
let post: any = null;
let contentHtml = '';

try {
  post = await getPostBySlug(slug!);
  if (post?.content) {
    contentHtml = await marked.parse(post.content);
  }
} catch (e) {
  console.error('获取文章失败:', e);
}

if (!post) {
  return new Response(null, { status: 302, headers: { Location: '/posts/' } });
}

const formattedDate = new Date(post.createdAt).toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Layout title={post.title} description={post.excerpt || post.description || ''} image={post.cover} ogType="article">
  <article class="max-w-3xl mx-auto">
    {post.cover && (
      <img src={post.cover} alt={post.title} class="w-full h-64 sm:h-80 object-cover rounded-2xl mb-8" />
    )}
    <h1 class="text-2xl sm:text-3xl font-bold mb-4" style="font-family: var(--font-heading)">
      {post.title}
    </h1>
    <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-text-secondary)] mb-8 pb-6 border-b border-[var(--color-border)]">
      <time datetime={post.createdAt}>{formattedDate}</time>
      <span>{post.viewCount || 0} 阅读</span>
      {post.category && (
        <span class="px-2 py-0.5 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] text-xs">
          {post.category.name}
        </span>
      )}
      {post.tags && post.tags.length > 0 && post.tags.map((tag: any) => (
        <span>#{tag.name}</span>
      ))}
    </div>
    <div class="prose max-w-none">
      <Fragment set:html={contentHtml} />
    </div>
    <div class="flex flex-wrap gap-2 mt-10 pt-6 border-t border-[var(--color-border)]">
      {post.tags && post.tags.map((tag: any) => (
        <a href={`/search?q=${tag.name}`} class="px-3 py-1 rounded-full bg-[var(--color-primary-light)] text-sm text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-all">
          #{tag.name}
        </a>
      ))}
    </div>
    <div class="mt-12 pt-6 border-t border-[var(--color-border)]">
      <CommentSection targetType="POST" targetId={post.id} />
    </div>
  </article>
</Layout>
