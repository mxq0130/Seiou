---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const categories = [...new Set(allPosts.map(p => p.data.category))];
const tagSet = new Set(allPosts.flatMap(p => p.data.tags));

const stats = [
  { value: allPosts.length, label: '文章', icon: '📝' },
  { value: categories.length, label: '分类', icon: '📂' },
  { value: tagSet.size, label: '标签', icon: '🏷️' },
  { value: '365+', label: '运行天数', icon: '⏱' },
];

const quickLinks = [
  { icon:'🎬', title:'追番列表', desc:'记录追番旅程', href:'/anime' },
  { icon:'📷', title:'图集相册', desc:'美好瞬间定格', href:'/albums' },
  { icon:'📔', title:'生活日记', desc:'随时随地记录', href:'/diary' },
  { icon:'👤', title:'关于我', desc:'了解更多信息', href:'/about' },
];
---

<Layout title="首页" noSidebar>
  <Hero />

  <!-- 统计数字 -->
  <section class="py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ScrollReveal>
        <h2 class="text-2xl sm:text-3xl font-bold text-center mb-12 tracking-tight">站点数据</h2>
      </ScrollReveal>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {stats.map((stat, i) => (
          <ScrollReveal type="scale" delay={i * 120}>
            <div class="text-center group">
              <div class="text-3xl mb-3 group-hover:scale-110 transition-transform duration-300">{stat.icon}</div>
              <div class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] tracking-tight count-up" data-target={String(stat.value)}>0</div>
              <div class="text-sm text-[var(--color-text-secondary)] mt-1 font-medium">{stat.label}</div>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <!-- 快捷入口 -->
  <section class="py-20 border-t border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <ScrollReveal>
        <h2 class="text-2xl sm:text-3xl font-bold text-center mb-12 tracking-tight">探索更多</h2>
      </ScrollReveal>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {quickLinks.map((link, i) => (
          <ScrollReveal type="scale" delay={i * 100}>
            <a href={link.href} class="block rounded-2xl border border-[var(--color-border)] p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-primary)]/30 hover:shadow-lg group bg-[var(--color-surface)]">
              <div class="text-3xl mb-3 group-hover:scale-110 transition-transform duration-300">{link.icon}</div>
              <h3 class="text-sm font-bold text-[var(--color-text)] mb-1 tracking-tight">{link.title}</h3>
              <p class="text-xs text-[var(--color-text-secondary)]">{link.desc}</p>
            </a>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const raw = el.dataset.target || '0';
        const suffix = raw.includes('+') ? '+' : '';
        const target = parseInt(raw.replace('+', ''));
        const duration = 1800;
        const start = performance.now();
        function update(now: number) {
          const p = Math.min((now - start) / duration, 1);
          const ease = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.floor(ease * target) + suffix;
          if (p < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.count-up').forEach(el => observer.observe(el));
</script>
