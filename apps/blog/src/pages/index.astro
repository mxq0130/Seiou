---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import PostCard from '../components/PostCard.astro';

const posts = [
  { title: 'Markdown 写作完全指南', slug: 'markdown-guide', excerpt: '掌握 Markdown 的所有语法，包括扩展功能如数学公式、Mermaid 图表、代码块增强等。', cover: 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=400&h=300&fit=crop', category: '示例文章', tags: ['Markdown', 'Blogging'], date: '2025-01-20', readingTime: 8, pinned: true },
  { title: '加密文章示例', slug: 'encrypted-post', excerpt: '这篇文章已被加密，需要输入密码才能查看内容。', category: '技术分享', tags: ['Encryption', 'Test'], date: '2024-01-15', readingTime: 3 },
  { title: 'Markdown 扩展功能展示', slug: 'markdown-extended', excerpt: '了解 Mizuki 主题提供的 Markdown 扩展功能：Callout 提示框、GitHub 卡片、视频嵌入等。', cover: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=400&h=300&fit=crop', category: '示例文章', tags: ['Markdown', 'Demo', 'Example', 'Mizuki'], date: '2024-05-01', readingTime: 5 },
  { title: 'Mizuki 主题简易上手指南', slug: 'mizuki-guide', excerpt: '如何快速上手使用 Mizuki 博客主题，包括配置修改、文章编写和部署上线。', category: '使用指南', tags: ['Mizuki', 'Blogging', 'Customization'], date: '2024-04-01', readingTime: 6 },
  { title: '在文章中嵌入 Mermaid 图表', slug: 'mermaid-demo', excerpt: '使用 Mermaid 在文章中绘制流程图、时序图、甘特图等。', cover: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=300&fit=crop', category: '示例文章', tags: ['Markdown', 'Mermaid'], date: '2023-10-01', readingTime: 4 },
  { title: '在文章中嵌入视频', slug: 'video-post', excerpt: '这篇文章演示如何在博客文章中嵌入 Bilibili / YouTube 视频。', category: '示例文章', tags: ['Example', 'Video'], date: '2022-08-01', readingTime: 2 },
];
---

<Layout title="首页">
  <Banner />
  <div class="space-y-6">
    {posts.map(post => <PostCard {...post} />)}
  </div>
  <nav class="flex items-center justify-center gap-2 mt-10">
    <span class="px-4 py-2 rounded-lg text-sm text-[var(--color-text-secondary)] bg-[var(--color-surface)] cursor-not-allowed">上一页</span>
    <span class="px-3 py-2 rounded-lg text-sm font-medium bg-[var(--color-primary)] text-white">1</span>
    <span class="px-4 py-2 rounded-lg text-sm text-[var(--color-primary)] hover:bg-[var(--color-primary-light)] transition-all cursor-pointer">下一页</span>
  </nav>
</Layout>
