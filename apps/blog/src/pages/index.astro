---
import { getPosts, getStats } from '../lib/data';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Carousel from '../components/Carousel.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

let postCount = 0, catCount = 0, tagCount = 0, runDays = 1;
try {
  const [posts, stats] = await Promise.all([getPosts({ limit: 1 }), getStats()]);
  postCount = posts.total || 0;
  catCount = stats.categories || 0;
  tagCount = stats.tags || 0;
  runDays = stats.runningDays || 1;
} catch (e) {
  console.error('获取统计数据失败:', e);
}

const features = [
  { icon: '📝', title: '技术博客', desc: '记录前端开发、框架研究和编程实践中的心得与技巧。' },
  { icon: '🎬', title: '追番记录', desc: '分享正在追的动画作品，附带评分、进度和观后感。' },
  { icon: '📷', title: '摄影图集', desc: '用镜头捕捉生活中的美好瞬间，支持加密相册分享。' },
  { icon: '📔', title: '生活随笔', desc: '随时随地记录日常感悟，像朋友圈一样的轻量日记。' },
  { icon: '🔗', title: '友链交流', desc: '与志同道合的博主互相链接，建立个人网络圈。' },
  { icon: '🔍', title: '全文搜索', desc: '快速检索所有文章内容，按标题、标签和分类筛选。' },
];

const stats = [
  { value: String(postCount), label: '文章', icon: '📝' },
  { value: String(catCount), label: '分类', icon: '📂' },
  { value: String(tagCount), label: '标签', icon: '🏷️' },
  { value: String(runDays), label: '运行天数', icon: '⏱' },
];
---

<Layout title="首页" noSidebar>
  <Hero />
  <Carousel />

  <!-- 功能介绍卡片 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center mb-16">
      <ScrollReveal>
        <span class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-primary)] mb-4 block">WHAT I DO</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4">
          <span class="gradient-text">不只是博客</span>
        </h2>
        <p class="text-[var(--color-text-secondary)] text-lg max-w-xl mx-auto">
          这里汇集了我的技术分享、追番记录、摄影作品和生活随笔，一个完整的个人空间。
        </p>
      </ScrollReveal>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f, i) => (
        <ScrollReveal type="fade-up" delay={i * 80}>
          <div class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7 transition-all duration-500 hover:-translate-y-2 hover:border-[var(--color-primary)]/30 hover:shadow-xl hover:shadow-[var(--color-primary)]/5 relative overflow-hidden">
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="background: radial-gradient(circle at 50% 0%, rgba(232,115,138,0.08), transparent 70%);"></div>
            <div class="relative z-10">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-5 transition-transform duration-300 group-hover:scale-110" style="background: rgba(232,115,138,0.1);">
                {f.icon}
              </div>
              <h3 class="text-base font-bold text-[var(--color-text)] mb-2 tracking-tight">{f.title}</h3>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{f.desc}</p>
            </div>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </section>

  <!-- 统计数字 -->
  <section class="border-t border-[var(--color-border)] py-24" style="background: linear-gradient(135deg, var(--color-primary-light), transparent 50%);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat, i) => (
          <ScrollReveal type="scale" delay={i * 120}>
            <div class="text-center">
              <div class="text-3xl mb-3">{stat.icon}</div>
              <div class="text-3xl sm:text-4xl font-extrabold count-up tracking-tight" style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;" data-target={stat.value}>{stat.value}</div>
              <div class="text-sm text-[var(--color-text-secondary)] mt-1 font-medium">{stat.label}</div>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 text-center border-t border-[var(--color-border)]">
    <div class="max-w-2xl mx-auto px-4">
      <ScrollReveal>
        <span class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-primary)] mb-4 block">GET STARTED</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">开始探索吧</h2>
        <p class="text-[var(--color-text-secondary)] text-lg mb-8">
          这里有 {postCount} 篇文章等待你的发现。
        </p>
        <a href="/posts" class="inline-flex items-center gap-2 px-8 py-3 rounded-full font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[var(--color-primary)]/20" style="background: var(--color-gradient);">
          浏览全部文章
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </ScrollReveal>
    </div>
  </section>
</Layout>
