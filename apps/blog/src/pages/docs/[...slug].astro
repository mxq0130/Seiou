---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => {
    const docId = String(doc.id).replace(/\.mdx?$/, '');
    return {
      params: { slug: docId },
      props: { doc },
    };
  });
}

interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;
const { title, description } = doc.data;
const docId = String(doc.id).replace(/\.mdx?$/, '');

const { Content, headings } = await render(doc);

const allDocs = await getCollection('docs');
const sortedDocs = allDocs.sort((a, b) => a.data.order - b.data.order);
---

<Layout title={title} description={description}>
  <div class="container-page py-8 sm:py-12">
    <h1 class="text-3xl font-bold mb-8" style="color: var(--color-text);">📚 文档</h1>

    <div class="flex gap-8 lg:gap-12">
      <aside class="hidden md:block w-56 shrink-0">
        <nav class="sticky top-20 card p-4">
          <h4 class="font-semibold mb-3 text-sm" style="color: var(--color-text-secondary);">文档列表</h4>
          <ul class="flex flex-col gap-1 list-none p-0 m-0">
            {sortedDocs.map((d) => {
              const dId = String(d.id).replace(/\.mdx?$/, '');
              return (
              <li>
                <a
                  href={`/docs/${dId}`}
                  class={`block text-sm py-1.5 px-2 rounded no-underline transition-colors ${dId === docId ? 'font-semibold' : ''}`}
                  style={dId === docId
                    ? `background: var(--color-primary-container); color: var(--color-on-primary-container);`
                    : `color: var(--color-text-secondary);`
                  }
                >
                  {d.data.title}
                </a>
              </li>
            )})}
          </ul>
        </nav>
      </aside>

      <div class="flex-1 min-w-0">
        <div class="prose max-w-none">
          <Content />
        </div>
      </div>

      <aside class="hidden lg:block w-48 shrink-0">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</Layout>
