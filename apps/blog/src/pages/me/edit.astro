---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="编辑我的页面">
  <script>
    if(!localStorage.getItem('token')){window.location.href='/login?redirect=/me/edit';}
  </script>

  <div id="user-edit-app" style="display:flex; min-height:calc(100vh - 64px); margin:-1.5rem;">
    <div style="width:200px; background:var(--color-surface); border-right:1px solid var(--color-border); padding:20px 0;">
      <div style="padding:0 16px 16px; font-weight:700; font-size:18px; color:var(--color-primary); border-bottom:1px solid var(--color-border);">🌸 个人设置</div>
      <div class="side-tab active" data-tab="about" style="padding:12px 16px; cursor:pointer; color:var(--color-text); font-size:14px; border-left:3px solid var(--color-primary); background:var(--color-primary-light);">👤 个人信息</div>
      <div class="side-tab" data-tab="anime" style="padding:12px 16px; cursor:pointer; color:var(--color-text-secondary); font-size:14px; border-left:3px solid transparent;">🎬 追番管理</div>
    </div>

    <div style="flex:1; padding:24px; overflow-y:auto;">
      <div id="tab-about">
        <h2 style="margin-bottom:16px;">👤 个人信息</h2>
        <div id="about-form" style="max-width:600px;">
          <div style="margin-bottom:12px;"><label style="font-size:13px;color:var(--color-text-secondary)">头像URL</label>
            <div style="display:flex;gap:8px;margin-top:4px">
              <input id="about-avatar" class="edit-input" placeholder="https://..." style="flex:1" />
              <input type="file" id="about-avatar-file" accept="image/*" style="display:none" onchange="uploadAvatar()" />
              <button onclick="document.getElementById('about-avatar-file').click()" style="padding:8px 12px;background:var(--color-primary);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:12px;">上传</button>
            </div>
          </div>
          <div style="margin-bottom:12px;"><label style="font-size:13px;color:var(--color-text-secondary)">昵称</label><input id="about-name" class="edit-input" /></div>
          <div style="margin-bottom:12px;"><label style="font-size:13px;color:var(--color-text-secondary)">个人简介</label><textarea id="about-bio" class="edit-input" rows="3"></textarea></div>
          <div style="display:flex;gap:8px;margin-bottom:12px;">
            <div style="flex:1"><label style="font-size:13px;color:var(--color-text-secondary)">GitHub</label><input id="about-gh" class="edit-input" /></div>
            <div style="flex:1"><label style="font-size:13px;color:var(--color-text-secondary)">Bilibili</label><input id="about-bl" class="edit-input" /></div>
            <div style="flex:1"><label style="font-size:13px;color:var(--color-text-secondary)">Email</label><input id="about-em" class="edit-input" /></div>
          </div>

          <h3 style="margin:16px 0 8px;">🛠️ 技能栈</h3>
          <div id="skills-list"></div>
          <button onclick="addSkill()" style="margin-top:8px;padding:6px 14px;border:1px dashed var(--color-primary);color:var(--color-primary);background:transparent;border-radius:6px;cursor:pointer;font-size:12px;">+ 添加技能</button>

          <h3 style="margin:16px 0 8px;">🚀 项目经历</h3>
          <div id="projects-list"></div>
          <button onclick="addProject()" style="margin-top:8px;padding:6px 14px;border:1px dashed var(--color-primary);color:var(--color-primary);background:transparent;border-radius:6px;cursor:pointer;font-size:12px;">+ 添加项目</button>

          <h3 style="margin:16px 0 8px;">📅 时间线</h3>
          <div id="timeline-list"></div>
          <button onclick="addTimeline()" style="margin-top:8px;padding:6px 14px;border:1px dashed var(--color-primary);color:var(--color-primary);background:transparent;border-radius:6px;cursor:pointer;font-size:12px;">+ 添加事件</button>

          <div style="margin-top:20px;">
            <button id="about-save" onclick="saveAbout()" style="padding:10px 24px;background:var(--color-gradient);color:#fff;border:none;border-radius:20px;cursor:pointer;font-weight:600;font-size:14px;">💾 保存个人信息</button>
            <span id="about-msg" style="margin-left:12px;font-size:13px;"></span>
          </div>
        </div>
      </div>

      <div id="tab-anime" style="display:none;">
        <h2 style="margin-bottom:16px;">🎬 我的追番</h2>
        <button onclick="openAnimeEdit()" style="margin-bottom:12px;padding:8px 16px;background:var(--color-primary);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:13px;">+ 添加番剧</button>
        <div id="anime-list"></div>

        <div id="anime-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:100;justify-content:center;align-items:center;">
          <div style="background:var(--color-surface);border-radius:12px;padding:24px;width:90%;max-width:500px;max-height:80vh;overflow-y:auto;">
            <h3 id="anime-modal-title" style="margin-bottom:16px;">添加番剧</h3>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <input id="anime-title" class="edit-input" placeholder="标题 *" />
              <input id="anime-cover" class="edit-input" placeholder="封面URL" />
              <div style="display:flex;gap:8px;">
                <input id="anime-progress" class="edit-input" type="number" placeholder="已看" style="flex:1" />
                <input id="anime-total" class="edit-input" type="number" placeholder="总集数" style="flex:1" />
                <input id="anime-rating" class="edit-input" type="number" step="0.1" placeholder="评分" style="flex:1" />
              </div>
              <div style="display:flex;gap:8px;">
                <input id="anime-year" class="edit-input" type="number" placeholder="年份" style="flex:1" />
                <input id="anime-studio" class="edit-input" placeholder="制作公司" style="flex:1" />
                <input id="anime-genre" class="edit-input" placeholder="类型" style="flex:1" />
              </div>
              <select id="anime-status" class="edit-input">
                <option value="WATCHING">在看</option><option value="COMPLETED">已看</option><option value="PLANNING">想看</option><option value="DROPPED">弃番</option>
              </select>
              <textarea id="anime-note" class="edit-input" rows="2" placeholder="备注"></textarea>
            </div>
            <div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end;">
              <button onclick="closeAnimeModal()" style="padding:8px 16px;border:1px solid var(--color-border);background:transparent;border-radius:6px;cursor:pointer;">取消</button>
              <button onclick="saveAnime()" style="padding:8px 16px;background:var(--color-primary);color:#fff;border:none;border-radius:6px;cursor:pointer;">保存</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .edit-input { width:100%; padding:8px 12px; border:1px solid var(--color-border); border-radius:6px; background:var(--color-bg); color:var(--color-text); font-size:13px; margin-top:4px; box-sizing:border-box; }
    .edit-input:focus { outline:none; border-color:var(--color-primary); }
    .skill-row, .project-row, .timeline-row { display:flex; gap:6px; margin-bottom:6px; align-items:center; }
    .skill-row input, .project-row input, .timeline-row input { flex:1; }
    .anime-item { display:flex; justify-content:space-between; align-items:center; padding:10px 14px; margin-bottom:6px; background:var(--color-bg); border-radius:8px; }
  </style>
</Layout>

<script>
var token=localStorage.getItem('token');
var apiBase='/api/v1';
var editingAnimeId=null;

async function api(method,path,body){
  var h={'Content-Type':'application/json','Authorization':'Bearer '+token};
  var opts={method,headers:h};
  if(body)opts.body=JSON.stringify(body);
  var r=await fetch(apiBase+path,opts);
  return r.json();
}

// === 侧边栏切换 ===
document.querySelectorAll('.side-tab').forEach(function(t){
  t.addEventListener('click',function(){
    document.querySelectorAll('.side-tab').forEach(function(s){
      s.style.borderLeftColor='transparent';s.style.background='transparent';s.style.color='var(--color-text-secondary)';s.classList.remove('active');
    });
    this.style.borderLeftColor='var(--color-primary)';this.style.background='var(--color-primary-light)';this.style.color='var(--color-text)';this.classList.add('active');
    var tab=this.getAttribute('data-tab');
    document.getElementById('tab-about').style.display=tab==='about'?'block':'none';
    document.getElementById('tab-anime').style.display=tab==='anime'?'block':'none';
    if(tab==='anime')loadAnime();
  });
});

// === 上传头像 ===
async function uploadAvatar(){
  var file=document.getElementById('about-avatar-file').files[0];
  if(!file)return;
  var fd=new FormData();fd.append('file',file);
  var r=await fetch(apiBase+'/images/upload',{method:'POST',headers:{'Authorization':'Bearer '+token},body:fd});
  var j=await r.json();
  if(j.code===0)document.getElementById('about-avatar').value=j.data.url;
}

// === 关于页加载 ===
async function loadAbout(){
  var r=await api('GET','/about');
  if(r.code!==0)return;
  var d=r.data;
  document.getElementById('about-avatar').value=d.avatar||'';
  document.getElementById('about-name').value=d.name||'';
  document.getElementById('about-bio').value=d.bio||'';
  document.getElementById('about-gh').value=d.socialLinks?d.socialLinks.github:'';
  document.getElementById('about-bl').value=d.socialLinks?d.socialLinks.bilibili:'';
  document.getElementById('about-em').value=d.socialLinks?d.socialLinks.email:'';
  renderSkills(d.skills||[]);
  renderProjects(d.projects||[]);
  renderTimeline(d.timeline||[]);
}

function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function renderSkills(list){
  var h='';
  list.forEach(function(s,i){h+='<div class="skill-row"><input class="edit-input" value="'+esc(s.name)+'" data-idx="'+i+'" data-field="name" placeholder="技能名" style="flex:2" /><input class="edit-input" type="number" value="'+(s.level||0)+'" data-idx="'+i+'" data-field="level" placeholder="熟练度" /><button onclick="this.parentElement.remove()" style="color:red;border:none;background:none;cursor:pointer;font-size:16px;">×</button></div>';});
  document.getElementById('skills-list').innerHTML=h;
}
function renderProjects(list){
  var h='';
  list.forEach(function(p,i){h+='<div class="project-row"><input class="edit-input" value="'+esc(p.name)+'" data-idx="'+i+'" data-field="name" placeholder="项目名" /><input class="edit-input" value="'+esc(p.desc)+'" data-idx="'+i+'" data-field="desc" placeholder="描述" /><input class="edit-input" value="'+esc(p.url||'')+'" data-idx="'+i+'" data-field="url" placeholder="链接" /><button onclick="this.parentElement.remove()" style="color:red;border:none;background:none;cursor:pointer;font-size:16px;">×</button></div>';});
  document.getElementById('projects-list').innerHTML=h;
}
function renderTimeline(list){
  var h='';
  list.forEach(function(t,i){h+='<div class="timeline-row"><input class="edit-input" value="'+esc(t.year)+'" data-idx="'+i+'" data-field="year" placeholder="年份" /><input class="edit-input" value="'+esc(t.event)+'" data-idx="'+i+'" data-field="event" placeholder="事件" /><input class="edit-input" value="'+esc(t.desc)+'" data-idx="'+i+'" data-field="desc" placeholder="描述" /><button onclick="this.parentElement.remove()" style="color:red;border:none;background:none;cursor:pointer;font-size:16px;">×</button></div>';});
  document.getElementById('timeline-list').innerHTML=h;
}

function addSkill(){document.getElementById('skills-list').insertAdjacentHTML('beforeend','<div class="skill-row"><input class="edit-input" placeholder="技能名" style="flex:2" /><input class="edit-input" type="number" placeholder="熟练度" value="50" /><button onclick="this.parentElement.remove()" style="color:red;border:none;background:none;cursor:pointer;font-size:16px;">×</button></div>');}
function addProject(){document.getElementById('projects-list').insertAdjacentHTML('beforeend','<div class="project-row"><input class="edit-input" placeholder="项目名" /><input class="edit-input" placeholder="描述" /><input class="edit-input" placeholder="链接" /><button onclick="this.parentElement.remove()" style="color:red;border:none;background:none;cursor:pointer;font-size:16px;">×</button></div>');}
function addTimeline(){document.getElementById('timeline-list').insertAdjacentHTML('beforeend','<div class="timeline-row"><input class="edit-input" placeholder="年份" /><input class="edit-input" placeholder="事件" /><input class="edit-input" placeholder="描述" /><button onclick="this.parentElement.remove()" style="color:red;border:none;background:none;cursor:pointer;font-size:16px;">×</button></div>');}

function collectList(id,fields){
  var items=[];
  var rows=document.getElementById(id).querySelectorAll('.skill-row,.project-row,.timeline-row');
  rows.forEach(function(row){
    var item={};
    var inputs=row.querySelectorAll('input');
    for(var i=0;i<Math.min(fields.length,inputs.length);i++){
      if(inputs[i].type==='number')item[fields[i]]=Number(inputs[i].value)||0;
      else item[fields[i]]=inputs[i].value||'';
    }
    items.push(item);
  });
  return items;
}

async function saveAbout(){
  var data={
    avatar:document.getElementById('about-avatar').value,
    name:document.getElementById('about-name').value,
    bio:document.getElementById('about-bio').value,
    socialLinks:{github:document.getElementById('about-gh').value,bilibili:document.getElementById('about-bl').value,email:document.getElementById('about-em').value},
    skills:collectList('skills-list',['name','level']),
    projects:collectList('projects-list',['name','desc','url']),
    timeline:collectList('timeline-list',['year','event','desc'])
  };
  var r=await api('PUT','/about',data);
  var m=document.getElementById('about-msg');
  if(r.code===0){m.style.color='#52c41a';m.textContent='保存成功！';}
  else{m.style.color='#ff4d4f';m.textContent=r.message||'保存失败';}
}

async function loadAnime(){
  var r=await api('GET','/anime');
  if(r.code!==0)return;
  var list=r.data||[];
  var el=document.getElementById('anime-list');
  el.innerHTML=list.map(function(a){return'<div class="anime-item"><div><b>'+(a.title||'')+'</b> <span style="font-size:12px;color:var(--color-text-secondary)">'+(a.progress||0)+'/'+(a.total||0)+' ★'+(a.rating||0).toFixed(1)+'</span></div><div><button onclick="editAnime('+a.id+')" style="margin-right:8px;border:none;background:none;color:var(--color-primary);cursor:pointer;font-size:12px;">编辑</button><button onclick="delAnime('+a.id+')" style="border:none;background:none;color:red;cursor:pointer;font-size:12px;">删除</button></div></div>'}).join('');
}

function openAnimeEdit(){
  editingAnimeId=null;
  document.getElementById('anime-modal-title').textContent='添加番剧';
  ['title','cover','progress','total','rating','year','studio','genre','note'].forEach(function(f){document.getElementById('anime-'+f).value='';});
  document.getElementById('anime-status').value='WATCHING';
  document.getElementById('anime-modal').style.display='flex';
}
function closeAnimeModal(){document.getElementById('anime-modal').style.display='none';}

async function editAnime(id){
  var r=await api('GET','/anime');
  var a=(r.data||[]).find(function(x){return x.id===id;});
  if(!a)return;
  editingAnimeId=id;
  document.getElementById('anime-modal-title').textContent='编辑番剧';
  document.getElementById('anime-title').value=a.title||'';
  document.getElementById('anime-cover').value=a.cover||'';
  document.getElementById('anime-progress').value=a.progress||0;
  document.getElementById('anime-total').value=a.total||0;
  document.getElementById('anime-rating').value=a.rating||0;
  document.getElementById('anime-year').value=a.year||'';
  document.getElementById('anime-studio').value=a.studio||'';
  document.getElementById('anime-genre').value=a.genre||'';
  document.getElementById('anime-status').value=a.status||'WATCHING';
  document.getElementById('anime-note').value=a.note||'';
  document.getElementById('anime-modal').style.display='flex';
}

async function saveAnime(){
  var data={
    title:document.getElementById('anime-title').value,
    cover:document.getElementById('anime-cover').value,
    progress:Number(document.getElementById('anime-progress').value)||0,
    total:Number(document.getElementById('anime-total').value)||0,
    rating:Number(document.getElementById('anime-rating').value)||0,
    year:Number(document.getElementById('anime-year').value)||null,
    studio:document.getElementById('anime-studio').value,
    genre:document.getElementById('anime-genre').value,
    status:document.getElementById('anime-status').value,
    note:document.getElementById('anime-note').value,
  };
  var r;
  if(editingAnimeId){r=await api('PUT','/anime/'+editingAnimeId,data);}
  else{r=await api('POST','/anime',data);}
  if(r.code===0){closeAnimeModal();loadAnime();}
  else{alert(r.message||'保存失败');}
}

async function delAnime(id){if(confirm('确定删除？')){await api('DELETE','/anime/'+id);loadAnime();}}

loadAbout();
</script>
