---
import { getPosts } from '../lib/data';
import Layout from '../layouts/Layout.astro';

const query = (Astro.url.searchParams.get('q') || '').toLowerCase().trim();

let results: any[] = [];
if (query) {
  try {
    const data = await getPosts({ q: query, limit: 20 });
    results = data.list || [];
  } catch (e) {
    console.error('搜索失败:', e);
  }
}
---

<Layout title="搜索">
  <div class="max-w-2xl">
    <h1 class="text-2xl sm:text-3xl font-bold mb-6 gradient-text" style="font-family: var(--font-heading)">🔍 搜索</h1>
    <form action="/search" method="get" class="mb-8">
      <div class="relative">
        <input type="text" name="q" value={query} placeholder="搜索文章..." autocomplete="off" class="w-full px-5 py-3 pl-11 rounded-xl glass border border-[var(--color-border)] text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-secondary)] focus:outline-none focus:border-[var(--color-primary)] transition-colors" />
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        {query && <a href="/search" class="absolute right-4 top-1/2 -translate-y-1/2 text-[var(--color-text-secondary)] hover:text-[var(--color-text)]">✕</a>}
      </div>
    </form>
    {query ? (
      results.length > 0 ? (
        <div>
          <p class="text-sm text-[var(--color-text-secondary)] mb-4">找到 {results.length} 条结果</p>
          <div class="space-y-4">
            {results.map((post: any) => (
              <a href={`/posts/${post.slug}`} class="block glass rounded-xl p-5 card-accent transition-all hover:-translate-y-1" style="box-shadow: var(--shadow-card)">
                <h3 class="text-base font-semibold text-[var(--color-text)] mb-1" style="font-family: var(--font-heading)">{post.title}</h3>
                <p class="text-sm text-[var(--color-text-secondary)] line-clamp-2 mb-2">{post.excerpt || post.description || ''}</p>
                <div class="flex items-center gap-2 text-xs text-[var(--color-text-secondary)]">
                  {post.category && <span class="px-2 py-0.5 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]">{post.category.name}</span>}
                  {post.tags && post.tags.map((tag: any) => <span>#{tag.name}</span>)}
                </div>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <div class="text-center py-16"><div class="text-5xl mb-4">🔍</div><p class="text-[var(--color-text-secondary)]">没有找到相关内容</p></div>
      )
    ) : (
      <div class="text-center py-16 text-[var(--color-text-secondary)]"><div class="text-5xl mb-4">🔍</div><p>输入关键词搜索文章</p></div>
    )}
  </div>
</Layout>
