---
// 页脚组件
---

<footer style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
  <div class="container-page py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- 关于本站 -->
      <div>
        <h3 class="text-lg font-bold mb-3" style="color: var(--color-primary);">🌸 二次元博客</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
          一个基于 Astro 构建的二次元风格个人博客。<br/>
          分享技术、生活与热爱的一切。
        </p>
      </div>

      <!-- 快速链接 -->
      <div>
        <h4 class="font-semibold mb-3" style="color: var(--color-text);">快速链接</h4>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/archive" class="footer-link">归档</a>
          <a href="/docs" class="footer-link">文档</a>
          <a href="/gallery" class="footer-link">图集</a>
          <a href="/anime" class="footer-link">追番</a>
          <a href="/links" class="footer-link">友链</a>
          <a href="/about" class="footer-link">关于</a>
        </div>
      </div>

      <!-- 社交与订阅 -->
      <div>
        <h4 class="font-semibold mb-3" style="color: var(--color-text);">联系我</h4>
        <div class="flex gap-4">
          <a href="#" class="social-icon" title="GitHub" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="#" class="social-icon" title="Bilibili" aria-label="Bilibili">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 01-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 01.16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373z"/></svg>
          </a>
          <a href="#" class="social-icon" title="RSS" aria-label="RSS">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36zM4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27z"/><circle cx="4" cy="20" r="0" fill="currentColor"><animate attributeName="r" values="0;3;0" dur="1.5s" repeatCount="indefinite"/></circle></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- 分隔线 -->
    <div class="my-6" style="border-top: 1px solid var(--color-border);"></div>

    <!-- 版权 -->
    <div class="text-center text-sm" style="color: var(--color-text-secondary);">
      <p>&copy; {new Date().getFullYear()} 二次元博客 · Powered by Astro</p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }
  .footer-link:hover {
    color: var(--color-primary);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--color-text-secondary);
    background: transparent;
    transition: all 0.2s ease;
  }
  .social-icon:hover {
    color: var(--color-primary);
    background: var(--color-primary-container);
  }
</style>
