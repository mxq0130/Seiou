---
import { getSettings } from '../../lib/data';

const defaultList = [
  { title: 'secret base ~君がくれたもの~', artist: 'あの花' },
  { title: '打上花火', artist: 'DAOKO × 米津玄師' },
  { title: 'アイドル', artist: 'YOASOBI' },
];

let playlist = defaultList;
try {
  const s = await getSettings();
  if (s.musicPlaylist && s.musicPlaylist.length > 0) playlist = s.musicPlaylist;
} catch {}
---

<div class="glass rounded-xl p-5 card-accent">
  <h3 class="text-sm font-semibold text-[var(--color-text-secondary)] uppercase tracking-wide mb-4">🎵 音乐</h3>
  <div class="space-y-3">
    {playlist.map((song, i) => (
      <div class={`flex items-center gap-3 p-2 rounded-lg ${i===0?'bg-[var(--color-primary-light)]':'hover:bg-[var(--color-primary-light)]'} transition-all`}>
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] flex items-center justify-center text-white text-lg shrink-0">♪</div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-[var(--color-text)] truncate">{song.title}</p>
          <p class="text-xs text-[var(--color-text-secondary)] truncate">{song.artist}</p>
        </div>
      </div>
    ))}
  </div>
</div>
