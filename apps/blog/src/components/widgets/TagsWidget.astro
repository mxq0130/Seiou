---
import { getTags } from '../../lib/data';

let tags: Array<{ id: number; name: string; slug: string; postCount: number }> = [];
try {
  tags = await getTags();
} catch (e) {
  console.error('TagsWidget 加载失败:', e);
}
---

<div class="glass rounded-xl p-5 card-accent">
  <h3 class="text-sm font-semibold text-[var(--color-text-secondary)] uppercase tracking-wide mb-4">🏷️ 标签</h3>
  {tags.length > 0 ? (
    <div class="flex flex-wrap gap-2">
      {tags.map((t, i) => (
        <a href={`/posts?tag=${t.slug}`} class={`text-xs px-2.5 py-1 rounded-full bg-[var(--color-primary-light)] transition-all hover:text-white ${i%2===0 ? 'text-[var(--color-primary)] hover:bg-[var(--color-primary)]' : 'text-[var(--color-secondary)] hover:bg-[var(--color-secondary)]'}`}>{t.name}</a>
      ))}
    </div>
  ) : (
    <p class="text-xs text-[var(--color-text-secondary)] text-center py-2">暂无标签</p>
  )}
</div>
