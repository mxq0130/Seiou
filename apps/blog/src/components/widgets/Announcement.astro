---
import { getAnnouncements } from '../../lib/data';

let annId: number | null = null;
let annContent = '';
try {
  const list = await getAnnouncements({ active: true });
  if (list.length > 0) {
    annId = list[0].id;
    annContent = list[0].content;
  }
} catch (e) {
  console.error('Announcement 加载失败:', e);
}

if (!annId || !annContent) {
  // 没有活跃公告时不渲染
  return undefined;
}
---

<div id="announcement" class="glass rounded-xl p-5 card-accent relative">
  <button id="announcement-close" class="absolute top-3 right-3 w-6 h-6 flex items-center justify-center rounded-full text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-primary-light)] transition-all" aria-label="关闭公告">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <h3 class="text-sm font-semibold text-[var(--color-text-secondary)] uppercase tracking-wide mb-3">📢 公告</h3>
  <p class="text-sm text-[var(--color-text)] leading-relaxed">{annContent}</p>
  <div class="mt-3 text-right">
    <a href="/announcements" class="text-xs text-[var(--color-primary)] hover:underline">查看历史公告 →</a>
  </div>
</div>

<script is:inline>
  const annId = {annId};
  const el = document.getElementById('announcement');
  if (localStorage.getItem('announcement-closed-' + annId) === 'true') { el?.classList.add('hidden'); }
  document.getElementById('announcement-close')?.addEventListener('click', () => {
    el?.classList.add('hidden');
    localStorage.setItem('announcement-closed-' + annId, 'true');
  });
</script>
