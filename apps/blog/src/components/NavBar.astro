---
import { getSettings } from '../lib/data';
const navLinks = [
  { href: '/', label: '首页' },
  { href: '/posts/', label: '文章' },
  { href: '/archive/', label: '归档' },
  { href: '/links/', label: '友链' },
  { href: '/anime/', label: '追番' },
  { href: '/albums/', label: '图集' },
  { href: '/diary/', label: '日记' },
  { href: '/about/', label: '关于' },
];
const currentPath = Astro.url.pathname;
let siteTitle = '🌸 小破站';
try { const s = await getSettings(); if (s.title) siteTitle = s.title; } catch {}
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 glass border-b border-[var(--color-border)]">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 text-xl font-bold shrink-0" style="font-family: var(--font-title)">
        <span class="gradient-text">🌸 {siteTitle}</span>
      </a>
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a href={link.href} class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-300
            ${currentPath === link.href ? 'bg-[var(--color-primary-light)] text-[var(--color-primary)]' : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-primary-light)]'}`}>
            {link.label}
          </a>
        ))}
      </div>
      <!-- rest unchanged -->
      <div class="flex items-center gap-2">
        <a href="/search/" class="p-2 rounded-lg text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-primary-light)] transition-all" title="搜索" aria-label="搜索">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </a>
        <a href="/login" class="hidden sm:inline-flex text-xs px-3 py-1.5 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-all" id="nav-login-btn">登录</a>
        <a href="/register" class="hidden sm:inline-flex text-xs px-3 py-1.5 rounded-full border border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-all" id="nav-reg-btn">注册</a>
        <span id="nav-user-name" class="hidden text-sm font-medium text-[var(--color-primary)] cursor-pointer" onclick="window.location.href='/user/'+this.textContent"></span>
        <button id="theme-toggle" class="p-2 rounded-lg text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-primary-light)] transition-all" title="切换主题" aria-label="切换主题">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-primary-light)] transition-all" aria-label="菜单">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="mobile-menu" class="md:hidden hidden pb-4 pt-3">
      <div class="flex flex-col gap-1">
        {navLinks.map(link => (
          <a href={link.href} class={`px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150
            ${currentPath === link.href ? 'bg-[var(--color-primary-light)] text-[var(--color-primary)]' : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-primary-light)]'}`}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('icon-sun');
  const moonIcon = document.getElementById('icon-moon');
  const html = document.documentElement;
  function updateIcons() {
    const isDark = html.classList.contains('dark');
    sunIcon.classList.toggle('hidden', isDark);
    moonIcon.classList.toggle('hidden', !isDark);
  }
  // 登录状态检查
  (function(){
    var u=localStorage.getItem('user');
    if(u){try{var d=JSON.parse(u);document.getElementById('nav-login-btn')?.classList.add('hidden');document.getElementById('nav-reg-btn')?.classList.add('hidden');var n=document.getElementById('nav-user-name');if(n){n.classList.remove('hidden');n.textContent=d.username}}catch(e){}}
  })();

  updateIcons();
  toggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    updateIcons();
  });
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
