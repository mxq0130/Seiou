<div id="comments" class="space-y-6">
  <h3 class="text-lg font-semibold" style="font-family: var(--font-heading)">💬 评论 (2)</h3>
  <div class="space-y-4">
    <div class="glass rounded-xl p-4">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] flex items-center justify-center text-white text-sm font-bold shrink-0">匿</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1"><span class="text-sm font-medium text-[var(--color-text)]">匿名用户</span><span class="text-xs text-[var(--color-text-secondary)]">2025-06-15</span></div>
          <p class="text-sm text-[var(--color-text)] leading-relaxed">写得非常详细！对于 Markdown 新手来说很有帮助 👍</p>
          <button class="text-xs text-[var(--color-primary)] mt-1 hover:underline">回复</button>
        </div>
      </div>
    </div>
    <div class="glass rounded-xl p-4 ml-10 border-l-2 border-[var(--color-primary-light)]">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[var(--color-accent-blue)] to-[var(--color-secondary)] flex items-center justify-center text-white text-sm font-bold shrink-0">主</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1"><span class="text-sm font-medium text-[var(--color-primary)]">博主</span><span class="text-xs text-[var(--color-text-secondary)]">2025-06-15</span></div>
          <p class="text-sm text-[var(--color-text)] leading-relaxed">谢谢支持！后续会继续更新更多内容~</p>
        </div>
      </div>
    </div>
  </div>
  <div class="glass rounded-xl p-5 mt-6">
    <h4 class="text-sm font-semibold text-[var(--color-text)] mb-3">发表评论</h4>
    <form class="space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <input type="text" placeholder="昵称" class="px-3 py-2 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] text-sm text-[var(--color-text)] focus:outline-none focus:border-[var(--color-primary)] transition-colors" />
        <input type="email" placeholder="邮箱（不公开）" class="px-3 py-2 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] text-sm text-[var(--color-text)] focus:outline-none focus:border-[var(--color-primary)] transition-colors" />
      </div>
      <textarea rows="3" placeholder="说点什么吧..." class="w-full px-3 py-2 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] text-sm text-[var(--color-text)] focus:outline-none focus:border-[var(--color-primary)] transition-colors resize-none"></textarea>
      <button type="submit" class="px-5 py-2 rounded-lg text-sm font-medium text-white bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] hover:opacity-90 transition-opacity">提交评论</button>
    </form>
  </div>
</div>
