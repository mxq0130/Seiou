---
const { targetType = 'POST', targetId } = Astro.props as any;

// SSR 端预取 token（一般客户端提交，这里只预渲染评论列表）
let comments: any[] = [];
if (targetId) {
  try {
    const url = `http://127.0.0.1:3000/api/v1/comments?targetType=${targetType}&targetId=${targetId}`;
    const res = await fetch(url);
    const json: any = await res.json();
    if (json.code === 0) comments = json.data?.list || [];
  } catch (e) { /* 评论加载失败使用空列表 */ }
}
---

<div id="comments" class="mt-8">
  <h3 class="text-lg font-bold mb-6" style="font-family:var(--font-heading)">
    💬 评论 ({comments.length})
  </h3>

  {comments.length > 0 ? (
    <div class="space-y-4 mb-8">
      {comments.map((c: any) => (
        <div class="glass rounded-xl p-4">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] flex items-center justify-center text-white text-sm font-bold">
              {c.user?.username?.[0] || '?'}
            </div>
            <div>
              <span class="text-sm font-medium text-[var(--color-text)]">{c.user?.username || '匿名'}</span>
              <span class="text-xs text-[var(--color-text-secondary)] ml-2">{new Date(c.createdAt).toLocaleDateString('zh-CN')}</span>
            </div>
          </div>
          <p class="text-sm text-[var(--color-text)] leading-relaxed ml-11">{c.content}</p>
          {c.replies?.length > 0 && (
            <div class="ml-11 mt-3 space-y-2 border-l-2 border-[var(--color-primary-light)] pl-4">
              {c.replies.map((r: any) => (
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-[var(--color-primary)]">{r.user?.username || '匿名'}</span>
                    <span class="text-xs text-[var(--color-text-secondary)]">{new Date(r.createdAt).toLocaleDateString('zh-CN')}</span>
                  </div>
                  <p class="text-sm text-[var(--color-text)] mt-1">{r.content}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  ) : (
    <p class="text-center text-[var(--color-text-secondary)] py-8">暂无评论，来抢沙发吧~</p>
  )}

  <div id="comment-form" class="glass rounded-xl p-5">
    <h4 class="text-sm font-semibold text-[var(--color-text)] mb-3">发表评论</h4>
    <textarea id="comment-input" class="w-full p-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm text-[var(--color-text)] resize-none focus:outline-none focus:border-[var(--color-primary)]" rows="3" placeholder="说点什么吧..."></textarea>
    <div class="flex justify-end mt-3">
      <button id="comment-submit" class="px-5 py-2 rounded-full text-sm font-medium text-white transition-all hover:shadow-lg" style="background:var(--color-gradient);">
        提交评论
      </button>
    </div>
    <p id="comment-msg" class="text-xs mt-2 text-center hidden"></p>
  </div>
</div>

<div id="comment-meta" style="display:none" data-type={targetType} data-id={targetId}></div>

<script>
  var meta = document.getElementById('comment-meta');
  var targetType = meta?.getAttribute('data-type') || 'POST';
  var targetId = parseInt(meta?.getAttribute('data-id') || '0');
  var btn = document.getElementById('comment-submit');
  var input = document.getElementById('comment-input');
  var msg = document.getElementById('comment-msg');

  btn?.addEventListener('click', async function() {
    var content = input?.value.trim();
    if (!content) { msg.className='text-xs mt-2 text-center'; msg.style.color='#ff4d4f'; msg.style.display='block'; msg.textContent='请输入评论内容'; return; }

    btn.setAttribute('disabled','true');
    btn.textContent = '提交中...';

    try {
      var token = localStorage.getItem('token');
      if (!token) { msg.className='text-xs mt-2 text-center'; msg.style.color='#e8a020'; msg.style.display='block'; msg.textContent='请先登录后再评论'; btn.removeAttribute('disabled'); btn.textContent='提交评论'; return; }

      var res = await fetch('/api/v1/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ content: content, targetType: targetType, targetId: targetId })
      });
      var json = await res.json();
      if (json.code === 0) {
        msg.className='text-xs mt-2 text-center'; msg.style.color='#52c41a'; msg.style.display='block'; msg.textContent='评论成功！刷新页面查看';
        input.value = '';
      } else {
        msg.className='text-xs mt-2 text-center'; msg.style.color='#ff4d4f'; msg.style.display='block'; msg.textContent = json.message || '评论失败';
      }
    } catch(e) {
      msg.className='text-xs mt-2 text-center'; msg.style.color='#ff4d4f'; msg.style.display='block'; msg.textContent='网络错误';
    }
    btn.removeAttribute('disabled');
    btn.textContent = '提交评论';
  });
</script>
