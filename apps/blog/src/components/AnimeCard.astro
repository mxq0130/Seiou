---
export interface Props {
  title: string; cover?: string; progress: number; total: number;
  rating: number; status: 'watching' | 'completed' | 'planning' | 'dropped';
  note?: string; year?: number; studio?: string; genre?: string;
}

const { title, cover, progress, total, rating, status, note, year, studio, genre } = Astro.props;
const statusLabels: Record<string,{label:string;color:string}> = {
  watching: { label:'▶ 在看', color:'var(--color-accent-blue)' },
  completed: { label:'✓ 已看', color:'var(--color-success)' },
  planning: { label:'❤ 想看', color:'var(--color-primary)' },
  dropped: { label:'✗ 弃番', color:'var(--color-error)' },
};
const pct = total>0?Math.round(progress/total*100):0;
const info = statusLabels[status];
---

<div class="glass rounded-xl overflow-hidden card-accent transition-all duration-300 hover:-translate-y-1" style="box-shadow:var(--shadow-card)">
  <div class="flex gap-4 p-4">
    <div class="w-20 sm:w-24 shrink-0">
      <div class="aspect-[3/4] rounded-lg overflow-hidden bg-[var(--color-primary-light)]">
        {cover ? <img src={cover} alt={title} class="w-full h-full object-cover" loading="lazy"/> : <div class="w-full h-full flex items-center justify-center text-3xl" style="font-family:var(--font-title)">🎬</div>}
      </div>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-2 mb-1">
        <h3 class="text-base font-semibold text-[var(--color-text)] truncate">{title}</h3>
        <span class="text-xs px-2 py-0.5 rounded-full shrink-0 font-medium text-white" style={`background:${info.color}`}>{info.label}</span>
      </div>
      {note && <p class="text-sm text-[var(--color-text-secondary)] mb-2 line-clamp-1">{note}</p>}
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--color-text-secondary)] mb-2">
        {year && <span>📅 {year}</span>}
        {studio && <span>🏢 {studio}</span>}
        {genre && <span class="hidden sm:inline">🏷️ {genre}</span>}
      </div>
      <div class="flex items-center gap-3">
        <div class="flex-1 h-2 bg-[var(--color-primary-light)] rounded-full overflow-hidden">
          <div class="h-full rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] transition-all duration-500" style={`width:${pct}%`}></div>
        </div>
        <span class="text-xs text-[var(--color-text-secondary)] shrink-0">{progress}/{total} ({pct}%)</span>
      </div>
      <div class="flex items-center gap-1 mt-2"><span class="text-xs text-[var(--color-warning)]">★</span><span class="text-xs font-semibold text-[var(--color-text)]">{rating.toFixed(1)}</span></div>
    </div>
  </div>
</div>
