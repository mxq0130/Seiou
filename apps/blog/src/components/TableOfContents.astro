---
export interface Props { content: string; }
const { content } = Astro.props;

const headings: { level: number; text: string; id: string }[] = [];
for (const line of content.split('\n')) {
  const h2 = line.match(/^## (.+)/);
  const h3 = line.match(/^### (.+)/);
  if (h2) { const t = h2[1].trim(); headings.push({ level: 2, text: t, id: t.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9\u4e00-\u9fa5-]/g, '') }); }
  else if (h3) { const t = h3[1].trim(); headings.push({ level: 3, text: t, id: t.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9\u4e00-\u9fa5-]/g, '') }); }
}
---

<div class="sticky top-24">
  <h4 class="text-xs font-semibold text-[var(--color-text-secondary)] uppercase tracking-wide mb-4">📑 目录</h4>
  <nav class="space-y-1 text-sm max-h-[60vh] overflow-y-auto">
    {headings.map(h => (
      <a href={`#${h.id}`} class={`block py-1.5 transition-colors hover:text-[var(--color-primary)] ${h.level === 3 ? 'pl-4 text-[var(--color-text-secondary)]' : 'text-[var(--color-text)] font-medium'}`}>
        {h.text}
      </a>
    ))}
  </nav>
</div>
<style>nav::-webkit-scrollbar{width:4px}</style>
