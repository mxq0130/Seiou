# ============================================
# boke 博客 - API 服务环境变量
# 复制此文件为 .env 并修改实际值
# ============================================

# ----- 数据库连接 -----
# MySQL 连接字符串（格式：mysql://用户名:密码@主机:端口/数据库名）
# 1Panel: 127.0.0.1:3306，用户名和密码在 1Panel → 数据库 → MySQL 中查看
DATABASE_URL="mysql://boke:你的数据库密码@127.0.0.1:3306/boke"

# ----- JWT 密钥 -----
# 随机生成 32 位以上字符串（生产环境务必修改！）
# 生成方式: openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-32-char-string"

# ----- 服务端口 -----
PORT=3000

# ----- CORS 跨域来源 -----
# 开发: http://localhost:4321
# 生产: https://你的域名.com
CORS_ORIGIN="http://localhost:4321"

# ----- Node 环境 -----
NODE_ENV="production"

# ----- Mock 模式 -----
# 设为 false 连接真实数据库（生产环境必须为 false）
# 设为 true 使用内存 Mock 数据（不需要 MySQL，仅开发/演示用）
USE_MOCK=false
